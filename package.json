{
  "name": "navo",
  "version": "0.6.3",
  "description": "Navo：多供应商 AI 账号、模型与本地网关桌面管理工具",
  "main": "out/main/index.js",
  "author": "Navo contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:tunnel && vite build --config vite.mobile.config.ts && node scripts/dev.mjs",
    "dev:mobile": "vite --config vite.mobile.config.ts --open /mobile.html",
    "build:mobile": "npm run typecheck && vite build --config vite.mobile.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build && vite build --config vite.mobile.config.ts",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "tsc -p tsconfig.test.json && node --test artifacts/tests/tests/*.test.js",
    "test:cpu": "tsc -p tsconfig.test.json && node scripts/cpu-performance.mjs",
    "test:kimi-network": "tsc -p tsconfig.test.json && node scripts/kimi-auth-network-smoke.mjs",
    "test:migration:kimi": "tsc -p tsconfig.test.json && node scripts/session-migration-kimi-test.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:smoke": "npm run build && node scripts/custom-ai-smoke.mjs && node scripts/smoke.mjs && node scripts/tray-smoke.mjs && node scripts/session-migration-smoke.mjs",
    "test:update:mac": "tsc -p tsconfig.test.json && node scripts/test-mac-update.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:tunnel": "node scripts/prepare-cloudflared.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
